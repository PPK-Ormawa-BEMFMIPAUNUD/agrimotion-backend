generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  email         String          @unique
  password      String
  role          String          @default("USER")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @default(now())
  user_logins   user_logins[]
  watering_logs watering_logs[]

  @@map("users")
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  commodity String
  location  String
  area      Float?
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]

  @@map("farms")
}

model Device {
  id            String          @id @default(uuid()) @db.Uuid
  deviceCode    String          @unique
  espSerial     String          @unique
  farmId        String          @db.Uuid
  status        String          @default("OFFLINE")
  lastOnline    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  battery       Float?
  signal        Int?
  alerts        Alert[]
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sensors       Sensor[]
  telemetry     Telemetry[]
  watering_logs watering_logs[]

  @@index([farmId])
  @@map("devices")
}

model Sensor {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  type      String
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("sensors")
}

model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String   @db.Uuid
  timestamp    DateTime @default(now())
  nitrogen     Float?
  phosphorus   Float?
  potassium    Float?
  ph           Float?
  soilMoisture Float?
  temperature  Float?
  humidity     Float?
  lux          Float?
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([timestamp])
  @@map("telemetry")
}

model Alert {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  type      String
  message   String
  status    String   @default("UNRESOLVED")
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("alerts")
}

model user_logins {
  id      String   @id @db.Uuid
  userId  String   @db.Uuid
  loginAt DateTime @default(now())
  users   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model watering_logs {
  id        String   @id @db.Uuid
  deviceId  String   @db.Uuid
  userId    String?  @db.Uuid
  type      String
  duration  Int
  createdAt DateTime @default(now())
  devices   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  users     User?    @relation(fields: [userId], references: [id])
}

model CropCycle {
  id                String         @id @default(uuid()) @db.Uuid
  demplotId         Int
  commodityName     String
  plantingDate      DateTime
  targetHarvestDate DateTime?
  harvestDate       DateTime?
  yieldKg           Float?
  notes             String?
  status            String         @default("ACTIVE")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activities        FarmActivity[]

  @@index([demplotId, status])
  @@map("crop_cycles")
}

enum ActivityType {
  WATERING
  FERTILIZATION
  SPRAYING
}

model FarmActivity {
  id            String       @id @default(uuid()) @db.Uuid
  demplotId     Int          // 0: Pacah, 1: Sawi, 2: Cabai
  cropCycleId   String?      @db.Uuid
  type          ActivityType
  volumeLiter   Float?       // Volume air / larutan (L)
  substanceName String?      // Nama pupuk/cairan
  dosage        String?      // Dosis/takaran
  notes         String?      // Catatan perlakuan
  executedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  cropCycle     CropCycle?   @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  @@index([demplotId, type, executedAt])
  @@map("farm_activities")
}
